# Windows preview defaults to 127.0.0.1. Use 0.0.0.0 on the Pi/LAN.
MYCOLOGGER_HOST=127.0.0.1
MYCOLOGGER_PORT=8080

# Leave blank for automatic USB discovery. Set COM6 on Windows or a
# /dev/serial/by-id/... path on Linux to force one specific receiver.
MYCOLOGGER_RECEIVER_PORT=
MYCOLOGGER_RECEIVER_BAUD=115200
MYCOLOGGER_RECEIVER_RETRY_SECONDS=1.0
MYCOLOGGER_RECEIVER_ENABLED=true
MYCOLOGGER_LOCAL_TIMEZONE=America/New_York

# Windows example:
# MYCOLOGGER_DATABASE_PATH=E:\PCB Design\MycoLogger\server\data\mycologger.sqlite3

# BTT Pi production location:
# MYCOLOGGER_DATABASE_PATH=/home/pi/mycologger-data/db/mycologger.sqlite3
# MYCOLOGGER_PHOTO_DIRECTORY=/home/pi/mycologger-data/photos
